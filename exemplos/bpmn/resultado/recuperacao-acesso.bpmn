<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_recuperacao_acesso" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ai-diagrams" exporterVersion="1">
  <bpmn:collaboration id="recuperacao_acesso_collaboration">
    <bpmn:participant id="recuperacao_acesso_pool" name="Recuperação de acesso à conta" processRef="recuperacao_acesso" />
  </bpmn:collaboration>
  <bpmn:process id="recuperacao_acesso" name="Recuperação de acesso à conta" isExecutable="false">
    <bpmn:documentation>Do pedido do cliente ao acesso recuperado ou à conta bloqueada. A segurança verifica a identidade por biometria; quando não confirma, a central valida por chamada, e a recusa nessa etapa bloqueia a conta.</bpmn:documentation>
    <bpmn:laneSet id="recuperacao_acesso_lanes">
      <bpmn:lane id="recuperacao_acesso_cliente" name="Cliente">
        <bpmn:flowNodeRef>recuperacao_acesso_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_entrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_fim_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="recuperacao_acesso_app" name="App">
        <bpmn:flowNodeRef>recuperacao_acesso_coletar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_cadastrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="recuperacao_acesso_seguranca" name="Segurança">
        <bpmn:flowNodeRef>recuperacao_acesso_verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_confirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_bloquear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_fim_bloqueio</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="recuperacao_acesso_central" name="Central de atendimento">
        <bpmn:flowNodeRef>recuperacao_acesso_validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recuperacao_acesso_aceita</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="recuperacao_acesso_inicio" name="Cliente pede&#10;recuperação">
      <bpmn:outgoing>recuperacao_acesso_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="recuperacao_acesso_coletar" name="Coletar documento&#10;e selfie">
      <bpmn:incoming>recuperacao_acesso_f1</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recuperacao_acesso_verificar" name="Verificar identidade&#10;por biometria">
      <bpmn:incoming>recuperacao_acesso_f2</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="recuperacao_acesso_confirmada" name="Identidade&#10;confirmada?" gatewayDirection="Diverging">
      <bpmn:incoming>recuperacao_acesso_f3</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f4</bpmn:outgoing>
      <bpmn:outgoing>recuperacao_acesso_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="recuperacao_acesso_validar" name="Validar por chamada&#10;com o cliente">
      <bpmn:incoming>recuperacao_acesso_f5</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="recuperacao_acesso_aceita" name="Validação&#10;aceita?" gatewayDirection="Diverging">
      <bpmn:incoming>recuperacao_acesso_f6</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f7</bpmn:outgoing>
      <bpmn:outgoing>recuperacao_acesso_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="recuperacao_acesso_cadastrar" name="Cadastrar nova senha&#10;e dispositivo">
      <bpmn:incoming>recuperacao_acesso_f4</bpmn:incoming>
      <bpmn:incoming>recuperacao_acesso_f7</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recuperacao_acesso_bloquear" name="Bloquear conta e&#10;registrar suspeita">
      <bpmn:incoming>recuperacao_acesso_f8</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recuperacao_acesso_entrar" name="Entrar com a&#10;nova senha">
      <bpmn:incoming>recuperacao_acesso_f9</bpmn:incoming>
      <bpmn:outgoing>recuperacao_acesso_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="recuperacao_acesso_fim_ok" name="Acesso recuperado">
      <bpmn:incoming>recuperacao_acesso_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="recuperacao_acesso_fim_bloqueio" name="Conta bloqueada">
      <bpmn:incoming>recuperacao_acesso_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="recuperacao_acesso_f1" sourceRef="recuperacao_acesso_inicio" targetRef="recuperacao_acesso_coletar" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f2" sourceRef="recuperacao_acesso_coletar" targetRef="recuperacao_acesso_verificar" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f3" sourceRef="recuperacao_acesso_verificar" targetRef="recuperacao_acesso_confirmada" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f4" sourceRef="recuperacao_acesso_confirmada" targetRef="recuperacao_acesso_cadastrar" name="Sim" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f5" sourceRef="recuperacao_acesso_confirmada" targetRef="recuperacao_acesso_validar" name="Não" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f6" sourceRef="recuperacao_acesso_validar" targetRef="recuperacao_acesso_aceita" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f7" sourceRef="recuperacao_acesso_aceita" targetRef="recuperacao_acesso_cadastrar" name="Sim" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f8" sourceRef="recuperacao_acesso_aceita" targetRef="recuperacao_acesso_bloquear" name="Não" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f9" sourceRef="recuperacao_acesso_cadastrar" targetRef="recuperacao_acesso_entrar" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f10" sourceRef="recuperacao_acesso_entrar" targetRef="recuperacao_acesso_fim_ok" />
    <bpmn:sequenceFlow id="recuperacao_acesso_f11" sourceRef="recuperacao_acesso_bloquear" targetRef="recuperacao_acesso_fim_bloqueio" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_recuperacao_acesso" name="Recuperação de acesso à conta">
    <bpmndi:BPMNPlane id="recuperacao_acesso_plane" bpmnElement="recuperacao_acesso_collaboration">
      <bpmndi:BPMNShape id="recuperacao_acesso_pool_di" bpmnElement="recuperacao_acesso_pool" isHorizontal="true">
        <dc:Bounds x="40" y="60" width="1820" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recuperacao_acesso_cliente_di" bpmnElement="recuperacao_acesso_cliente" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#6B7280">
        <dc:Bounds x="70" y="60" width="1790" height="160" />
      </bpmndi:BPMNShape>
