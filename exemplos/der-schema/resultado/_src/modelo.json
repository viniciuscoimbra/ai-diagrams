      ["valor", "numeric(18,2)", ""], ["ocorrido_em", "timestamptz", ""]] },
    "conta.outbox": { "tipo": "trilha", "rotulo": "evento a publicar", "colunas": [
      ["outbox_id", "uuid", "PK"], ["evento_id", "uuid", "UQ"], ["tipo_evento", "varchar(80)", ""], ["payload", "jsonb", ""]] },

    "cobranca.situacoes_fatura": { "tipo": "dominio", "rotulo": "aberta, paga, vencida, cancelada", "colunas": [
      ["situacao_fatura_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "cobranca.meios_pagamento": { "tipo": "dominio", "rotulo": "boleto, Pix, débito em conta", "colunas": [
      ["meio_pagamento_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "cobranca.faturas_cobranca": { "tipo": "forte", "rotulo": "a fatura emitida para o cliente", "colunas": [
      ["fatura_id", "uuid", "PK"], ["numero", "varchar(20)", "UQ"],
      ["cliente_id", "uuid", "FK", "cadastro.clientes", true], ["conta_id", "uuid", "FK", "conta.contas", true],
      ["moeda_id", "uuid", "FK", "comum.moedas", true], ["situacao_fatura_id", "uuid", "FK", "cobranca.situacoes_fatura", true],
      ["valor_total", "numeric(18,2)", ""], ["vencimento", "date", ""], ["emitida_em", "timestamptz", ""],
      ["criado_em", "timestamptz", ""], ["atualizado_em", "timestamptz", ""]] },
    "cobranca.itens_fatura": { "tipo": "dependente", "rotulo": "cada linha cobrada na fatura", "colunas": [
      ["item_id", "uuid", "PK"], ["fatura_id", "uuid", "FK", "cobranca.faturas_cobranca", true],
      ["descricao", "varchar(140)", ""], ["quantidade", "integer", ""], ["valor_unitario", "numeric(18,2)", ""]] },
    "cobranca.execucoes_cobranca": { "tipo": "controle", "rotulo": "execução do lote de cobrança do dia", "colunas": [
      ["execucao_id", "uuid", "PK"], ["data_referencia", "date", "UQ"], ["situacao", "varchar(20)", ""],
      ["iniciada_em", "timestamptz", ""]] },
    "cobranca.pagamentos_recebidos": { "tipo": "fato", "rotulo": "cada valor recebido; nunca muda", "colunas": [
      ["pagamento_recebido_id", "uuid", "PK"], ["fatura_id", "uuid", "FK", "cobranca.faturas_cobranca", false],
      ["conta_id", "uuid", "FK", "conta.contas", true], ["meio_pagamento_id", "uuid", "FK", "cobranca.meios_pagamento", true],
      ["identificador_externo", "varchar(40)", "UQ"], ["valor", "numeric(18,2)", ""], ["recebido_em", "timestamptz", ""]] },
    "cobranca.tentativas_cobranca": { "tipo": "fato", "rotulo": "cada tentativa de cobrar a fatura", "colunas": [
      ["tentativa_id", "uuid", "PK"], ["fatura_id", "uuid", "FK", "cobranca.faturas_cobranca", true],
      ["pagamento_recebido_id", "uuid", "FK", "cobranca.pagamentos_recebidos", false],
      ["meio_pagamento_id", "uuid", "FK", "cobranca.meios_pagamento", true],
      ["execucao_id", "uuid", "FK", "cobranca.execucoes_cobranca", false],
      ["numero_tentativa", "integer", ""], ["resultado", "varchar(20)", ""], ["tentada_em", "timestamptz", ""]] },
    "cobranca.outbox": { "tipo": "trilha", "rotulo": "evento a publicar, lido pelo CDC", "colunas": [
      ["outbox_id", "uuid", "PK"], ["evento_id", "uuid", "UQ"], ["agregado_id", "uuid", ""],
      ["tipo_evento", "varchar(80)", ""], ["payload", "jsonb", ""]] }
  }
}
