    "comum.paises": { "tipo": "referencia", "rotulo": "países ISO 3166", "colunas": [
      ["pais_id", "uuid", "PK"], ["codigo", "char(2)", "UQ"], ["nome", "varchar(80)", ""]] },
    "comum.feriados": { "tipo": "referencia", "rotulo": "feriados bancários", "colunas": [
      ["feriado_id", "uuid", "PK"], ["data", "date", "UQ"], ["descricao", "varchar(80)", ""]] },

    "cadastro.situacoes_cliente": { "tipo": "dominio", "rotulo": "ativo, bloqueado, encerrado", "colunas": [
      ["situacao_cliente_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "cadastro.clientes": { "tipo": "forte", "rotulo": "a pessoa que abre contas", "colunas": [
      ["cliente_id", "uuid", "PK"], ["documento", "varchar(14)", "UQ"], ["nome", "varchar(120)", ""],
