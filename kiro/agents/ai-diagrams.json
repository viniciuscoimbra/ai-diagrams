{
  "name": "ai-diagrams",
  "description": "Generates diagrams with the ai-diagrams skill",
  "prompt": "Use the ai-diagrams skill for every diagram request. Run the skill's commands directly, without creating a helper script.",
  "tools": [
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "fs_read"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "python3 [^;&|]* diagrams/[^;&|]*",
        "node [^;&|]* diagrams/[^;&|]*",
        "mkdir -p diagrams[^;&|]*",
        "ls[^;&|]*"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "diagrams/**"
      ]
    }
  },
  "resources": [
    "skill://.kiro/skills/*/SKILL.md",
    "file://.kiro/steering/ai-diagrams.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "python3 * diagrams/*",
          "node * diagrams/*",
          "mkdir -p diagrams*",
          "ls*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "diagrams/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:46bdd05db9f044dff4d83f47daaf97545d5c33427485c07d06f25e3528f82d91",
    "source": "sha256:b96ce08cd4b0030a6599fe0627ed29a95802ae2b248fc9aa2ba472be500638e4"
  }
}
