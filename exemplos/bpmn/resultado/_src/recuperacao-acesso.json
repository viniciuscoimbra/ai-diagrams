      "via": "top"
    },
    {
      "from": "confirmada",
      "to": "validar",
      "name": "Não"
    },
    {
      "from": "validar",
      "to": "aceita"
    },
    {
      "from": "aceita",
      "to": "cadastrar",
      "name": "Sim"
    },
    {
      "from": "aceita",
      "to": "bloquear",
      "name": "Não"
    },
    {
      "from": "cadastrar",
      "to": "entrar"
