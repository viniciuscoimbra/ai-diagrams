  "description": "Diagram sources, generators and quality gates for AI coding agents",
  "license": "MIT",
  "author": "Vinícius Coimbra <viniciuscoimbra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuscoimbra/ai-diagrams.git"
  },
  "homepage": "https://github.com/viniciuscoimbra/ai-diagrams#readme",
  "bin": {
    "ai-diagrams": "bin/ai-diagrams.mjs"
  },
