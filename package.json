{
  "name": "ai-diagrams",
  "version": "0.2.0",
  "description": "Diagram sources, generators and quality gates for AI coding agents",
  "license": "MIT",
  "author": "Vinícius Coimbra <viniciuscoimbra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuscoimbra/ai-diagrams.git"
  },
  "homepage": "https://github.com/viniciuscoimbra/ai-diagrams#readme",
  "bin": {
    "ai-diagrams": "bin/ai-diagrams.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/ai-diagrams.mjs",
    "INSTALL.md",
    "docs/*.md",
    "tools/install-kiro.sh",
    "kiro/",
    "skills/ai-diagrams/SKILL.md",
    "skills/ai-diagrams/assets/",
    "skills/ai-diagrams/bpmn/*.py",
    "skills/ai-diagrams/c4/",
    "skills/ai-diagrams/bpmn/vendor/",
    "skills/ai-diagrams/er/*.mjs",
    "!skills/ai-diagrams/er/*.test.mjs",
    "skills/ai-diagrams/states/",
    "skills/ai-diagrams/i18n/*.json",
    "skills/ai-diagrams/templates/*/_src/**",
    "skills/ai-diagrams/templates/build-all.sh",
    "skills/ai-diagrams/references/",
    "skills/ai-diagrams/scripts/*.py",
    "skills/ai-diagrams/scripts/spec_keys.json",
    "skills/ai-diagrams/themes/"
  ],
  "scripts": {
    "test": "bash tests/npm-smoke.sh"
  }
}
