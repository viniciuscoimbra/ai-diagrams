{
  "name": "ai-diagrams",
  "description": "Gera diagramas com a skill ai-diagrams",
  "prompt": "Use a skill ai-diagrams em todo pedido de diagrama. Rode os comandos da skill direto, sem criar script auxiliar.",
  "tools": [
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "fs_read"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "python3 [^;&|]*diagramas/[^;&|]*",
        "node [^;&|]*diagramas/[^;&|]*",
        "mkdir -p diagramas[^;&|]*",
        "ls[^;&|]*"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "diagramas/**"
      ]
    }
  },
  "resources": [
    "skill://.kiro/skills/*/SKILL.md",
    "file://.kiro/steering/ai-diagrams.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "python3 *diagramas/*",
          "node *diagramas/*",
          "mkdir -p diagramas*",
          "ls*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "diagramas/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:46bdd05db9f044dff4d83f47daaf97545d5c33427485c07d06f25e3528f82d91",
    "source": "sha256:b96ce08cd4b0030a6599fe0627ed29a95802ae2b248fc9aa2ba472be500638e4"
  }
}
