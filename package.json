    "skills/ai-diagrams/estados/",
    "skills/ai-diagrams/i18n/*.json",
    "skills/ai-diagrams/modelos/*/_src/**",
    "skills/ai-diagrams/modelos/gerar.sh",
    "skills/ai-diagrams/references/",
    "skills/ai-diagrams/scripts/*.py",
    "skills/ai-diagrams/temas/"
  ],
  "scripts": {
    "test": "bash testes/npm-smoke.sh"
  }
