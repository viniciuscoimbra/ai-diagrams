{
  "cabecalho": "Prosa · Modelos de diagrama · Fintech de exemplo",
  "rodape": "Diagramas &nbsp;·&nbsp; modelo lógico de exemplo &nbsp;·&nbsp; 2026-11",
  "schemaComum": "comum",
  "schemaLeitura": null,
  "colunasControle": [],
  "schemas": {
    "comum": "domínios gerais e referências",
    "cadastro": "Cadastro de clientes",
    "conta": "Contas e movimentos",
    "pagamento": "Pagamentos",
    "extrato": "Extrato do cliente"
  },
  "tabelas": {
    "comum.moedas": { "tipo": "referencia", "rotulo": "moedas ISO 4217", "colunas": [
      ["moeda_id", "uuid", "PK"], ["codigo", "char(3)", "UQ"], ["nome", "varchar(60)", ""]] },
    "comum.paises": { "tipo": "referencia", "rotulo": "países ISO 3166", "colunas": [
      ["pais_id", "uuid", "PK"], ["codigo", "char(2)", "UQ"], ["nome", "varchar(80)", ""]] },

    "cadastro.clientes": { "tipo": "forte", "rotulo": "a pessoa que abre contas", "colunas": [
      ["cliente_id", "uuid", "PK"], ["documento", "varchar(14)", "UQ"], ["nome", "varchar(120)", ""],
      ["situacao_cliente_id", "uuid", "FK", "cadastro.situacoes_cliente", true], ["criado_em", "timestamptz", ""]] },
    "cadastro.enderecos": { "tipo": "dependente", "rotulo": "endereços do cliente", "colunas": [
      ["endereco_id", "uuid", "PK"], ["cliente_id", "uuid", "FK", "cadastro.clientes", true],
      ["pais_id", "uuid", "FK", "comum.paises", true], ["logradouro", "varchar(160)", ""], ["cep", "varchar(9)", ""]] },
    "cadastro.situacoes_cliente": { "tipo": "dominio", "rotulo": "ativo, bloqueado, encerrado", "colunas": [
      ["situacao_cliente_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },

    "conta.contas": { "tipo": "forte", "rotulo": "a conta de pagamento do cliente", "colunas": [
      ["conta_id", "uuid", "PK"], ["cliente_id", "uuid", "FK", "cadastro.clientes", true], ["numero", "varchar(20)", "UQ"],
      ["moeda_id", "uuid", "FK", "comum.moedas", true], ["situacao_conta_id", "uuid", "FK", "conta.situacoes_conta", true],
      ["aberta_em", "timestamptz", ""], ["criado_em", "timestamptz", ""], ["atualizado_em", "timestamptz", ""]] },
    "conta.titulares": { "tipo": "associativa", "rotulo": "quem pode movimentar a conta", "colunas": [
      ["titular_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true],
      ["cliente_id", "uuid", "FK", "cadastro.clientes", true], ["papel", "varchar(20)", ""]] },
    "conta.movimentos": { "tipo": "fato", "rotulo": "cada crédito ou débito na conta", "colunas": [
      ["movimento_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true],
      ["tipo_movimento_id", "uuid", "FK", "conta.tipos_movimento", true], ["valor", "numeric(18,2)", ""],
      ["sequencia_evento", "bigint", ""], ["ocorrido_em", "timestamptz", ""],
      ["pagamento_id", "uuid", "FK", "pagamento.pagamentos", false]] },
    "conta.saldos": { "tipo": "projecao", "rotulo": "saldo calculado a partir dos movimentos", "colunas": [
      ["saldo_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true], ["saldo", "numeric(18,2)", ""],
      ["ultimo_movimento_id", "uuid", "FK", "conta.movimentos", false], ["atualizado_em", "timestamptz", ""]] },
    "conta.limites": { "tipo": "versionada", "rotulo": "limite da conta, uma versão por mudança", "colunas": [
      ["limite_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true], ["valor", "numeric(18,2)", ""],
      ["versao", "integer", ""], ["vigente_desde", "timestamptz", ""]] },
    "conta.outbox": { "tipo": "trilha", "rotulo": "evento a publicar, lido pelo CDC", "colunas": [
      ["outbox_id", "uuid", "PK"], ["evento_id", "uuid", "UQ"], ["agregado_id", "uuid", ""],
      ["tipo_evento", "varchar(80)", ""], ["payload", "jsonb", ""]] },
    "conta.fechamentos_diarios": { "tipo": "controle", "rotulo": "execução do fechamento de cada dia", "colunas": [
      ["fechamento_id", "uuid", "PK"], ["data_referencia", "date", "UQ"], ["situacao", "varchar(20)", ""],
      ["iniciado_em", "timestamptz", ""]] },
    "conta.situacoes_conta": { "tipo": "dominio", "rotulo": "aberta, bloqueada, encerrada", "colunas": [
      ["situacao_conta_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "conta.tipos_movimento": { "tipo": "dominio", "rotulo": "crédito, débito, estorno", "colunas": [
      ["tipo_movimento_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "conta.transicoes_situacao_conta": { "tipo": "configuracao", "rotulo": "trocas de situação permitidas", "colunas": [
      ["transicao_id", "uuid", "PK"], ["situacao_origem_id", "uuid", "FK", "conta.situacoes_conta", true],
      ["situacao_destino_id", "uuid", "FK", "conta.situacoes_conta", true]] },

    "pagamento.pagamentos": { "tipo": "forte", "rotulo": "ordem de pagamento do cliente", "colunas": [
      ["pagamento_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true], ["valor", "numeric(18,2)", ""],
      ["moeda_id", "uuid", "FK", "comum.moedas", true], ["situacao", "varchar(20)", ""], ["criado_em", "timestamptz", ""]] },
    "pagamento.outbox": { "tipo": "trilha", "rotulo": "evento a publicar", "colunas": [
      ["outbox_id", "uuid", "PK"], ["evento_id", "uuid", "UQ"], ["payload", "jsonb", ""]] },

    "extrato.lancamentos": { "tipo": "projecao", "rotulo": "linha do extrato exibida no app", "colunas": [
      ["lancamento_id", "uuid", "PK"], ["conta_id", "uuid", "FK", "conta.contas", true],
      ["movimento_id", "uuid", "FK", "conta.movimentos", true], ["valor", "numeric(18,2)", ""], ["descricao", "varchar(140)", ""]] },
    "extrato.eventos_processados": { "tipo": "trilha", "rotulo": "deduplicação de consumo", "colunas": [
      ["evento_id", "uuid", "PK"], ["processado_em", "timestamptz", ""]] }
  }
}
