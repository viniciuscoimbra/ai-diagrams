    "cadastro.enderecos": { "tipo": "dependente", "rotulo": "endereços do cliente", "colunas": [
      ["endereco_id", "uuid", "PK"], ["cliente_id", "uuid", "FK", "cadastro.clientes", true],
      ["pais_id", "uuid", "FK", "comum.paises", true], ["logradouro", "varchar(160)", ""], ["cep", "varchar(9)", ""]] },

    "conta.situacoes_conta": { "tipo": "dominio", "rotulo": "aberta, bloqueada, encerrada", "colunas": [
      ["situacao_conta_id", "uuid", "PK"], ["codigo", "varchar(20)", "UQ"]] },
    "conta.contas": { "tipo": "forte", "rotulo": "a conta de pagamento do cliente", "colunas": [
      ["conta_id", "uuid", "PK"], ["cliente_id", "uuid", "FK", "cadastro.clientes", true], ["numero", "varchar(20)", "UQ"],
