{
  "lang": "en",
  "header": [
    "ai-diagrams · Boleto billing system",
    "C4 · V2"
  ],
  "footer": [
    "ai-diagrams · C4 model",
    "boleto billing"
  ],
  "main": "containers",
  "elements": [
    {
      "id": "cliente",
      "type": "person",
      "name": "Business customer",
      "description": "issues boletos and tracks payments"
    },
    {
      "id": "analista",
      "type": "person",
      "name": "Finance analyst",
      "description": "handles duplicate payments and refunds"
    },
    {
      "id": "cobranca",
      "type": "system",
      "name": "Billing system",
      "description": "issues the boleto, registers it with CIP and settles it from the return file"
    },
    {
      "id": "cip",
      "type": "system",
      "external": true,
      "owner": "CIP",
      "name": "New Billing Platform",
      "description": "boleto registration"
    },
    {
      "id": "liquidante",
      "type": "system",
      "external": true,
      "owner": "partner",
      "name": "Settlement bank",
      "description": "generates the CNAB 240 return file"
    },
    {
      "id": "webhook",
      "type": "system",
      "external": true,
      "owner": "business customer",
      "name": "Customer webhook",
      "description": "receives the boleto payment notification"
    },
    {
      "id": "erp",
      "type": "system",
      "owner": "another team",
      "name": "Accounting ERP",
      "description": "records the entry for each settlement"
    },
    {
      "id": "portal",
      "type": "container",
      "parent": "cobranca",
      "shape": "web",
      "technology": "Next.js on Vercel",
      "name": "Business portal",
      "description": "batch issuance and receipts dashboard"
    },
    {
      "id": "backoffice",
      "type": "container",
      "parent": "cobranca",
      "shape": "web",
      "technology": "React",
      "name": "Backoffice",
      "description": "boleto lookup and manual adjustments"
    },
    {
      "id": "api",
      "type": "container",
      "parent": "cobranca",
      "technology": "Node.js on Lambda",
      "icon": "aws://compute/lambda.png",
      "name": "Billing API",
      "description": "behind API Gateway; validates the payer and stores the boleto"
    },
    {
      "id": "banco",
      "type": "container",
      "parent": "cobranca",
      "shape": "database",
      "technology": "DynamoDB",
      "icon": "aws://database/dynamodb.png",
      "name": "Billing database",
      "description": "boletos, status and event history"
    },
    {
      "id": "processador",
      "type": "container",
      "parent": "cobranca",
      "technology": "Lambda and SQS queue",
      "icon": "aws://compute/lambda.png",
      "name": "Return file processor",
      "description": "reads the return file and settles the boleto"
    },
    {
      "id": "rotas",
      "type": "component",
      "parent": "api",
      "technology": "Fastify",
      "name": "Boleto routes",
      "description": "receives issuance, lookup and adjustment"
    },
    {
      "id": "acesso",
      "type": "component",
      "parent": "api",
      "technology": "Cognito JWT",
      "name": "Access control",
      "description": "checks whether the caller is a customer or an operator"
    },
    {
      "id": "pagador",
      "type": "component",
      "parent": "api",
      "technology": "TypeScript",
      "name": "Payer validator",
      "description": "checks CPF or CNPJ, due date and amount"
    },
    {
      "id": "registro",
      "type": "component",
      "parent": "api",
      "technology": "HTTPS client with certificate",
      "name": "CIP registration",
      "description": "registers the boleto and returns the payment code"
    },
    {
      "id": "repositorio",
      "type": "component",
      "parent": "api",
      "technology": "AWS SDK",
      "name": "Boleto repository",
      "description": "reads and writes boleto, status and event"
    },
    {
      "id": "aws",
      "type": "deploymentNode",
      "environment": "producao",
      "name": "AWS account billing-prod",
      "technology": "sa-east-1"
    },
    {
      "id": "gateway",
      "type": "infrastructureNode",
      "parent": "aws",
      "technology": "Amazon API Gateway, with WAF",
      "name": "Public API",
      "description": "terminates TLS and checks the token"
    },
    {
      "id": "lambda-api",
      "type": "deploymentNode",
      "parent": "aws",
      "name": "AWS Lambda",
      "technology": "Node.js 20"
    },
    {
      "id": "api-1",
      "type": "containerInstance",
      "parent": "lambda-api",
      "container": "api"
    },
    {
      "id": "dynamo",
      "type": "deploymentNode",
      "parent": "aws",
      "name": "Amazon DynamoDB",
      "technology": "on demand"
    },
    {
      "id": "banco-1",
      "type": "containerInstance",
      "parent": "dynamo",
      "container": "banco"
    },
    {
      "id": "bucket",
      "type": "infrastructureNode",
      "parent": "aws",
      "technology": "Amazon S3, through Transfer Family",
      "name": "Return inbox",
      "description": "receives the CNAB 240 over SFTP"
    },
    {
      "id": "fila",
      "type": "infrastructureNode",
      "parent": "aws",
      "technology": "Amazon SQS",
      "name": "Return queue",
      "description": "one event per new file"
    },
    {
      "id": "lambda-ret",
      "type": "deploymentNode",
      "parent": "aws",
      "name": "AWS Lambda",
      "technology": "Node.js 20"
    },
    {
      "id": "processador-1",
      "type": "containerInstance",
      "parent": "lambda-ret",
      "container": "processador"
    },
    {
      "id": "vercel",
      "type": "deploymentNode",
      "environment": "producao",
      "name": "Vercel",
      "technology": "edge network"
    },
    {
      "id": "portal-1",
      "type": "containerInstance",
      "parent": "vercel",
      "container": "portal"
    },
    {
      "id": "cdn",
      "type": "deploymentNode",
      "environment": "producao",
      "name": "Amazon CloudFront",
      "technology": "static site on S3"
    },
    {
      "id": "backoffice-1",
      "type": "containerInstance",
      "parent": "cdn",
      "container": "backoffice"
    }
  ],
  "relationships": [
